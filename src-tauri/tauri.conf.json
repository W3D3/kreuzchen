{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kreuzchen",
  "version": "0.2.0",
  "identifier": "io.github.w3d3.kreuzchen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kreuzchen",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NERBQjVBQjgzRDIxRjgKUldUNElUMjRXcXROZUUrZWZ2TkpnT2VwcGgya3czMjhNR0FPRzlvaDMrSW1BMUQ4NDc0MmNJTnEK",
      "endpoints": [
        "https://github.com/W3D3/kreuzchen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
